# Copy to .env (gitignored) and fill in. Read by docker-compose.yml.

# Required. HMAC key for API key hashes. Generate one with: openssl rand -base64 32
# Don't change it later: every app's API key would stop working.
API_KEY_SALT=

# The first Argus admin, created on the first start. You must change the password at first sign-in.
# Leave ADMIN_PASSWORD empty to have one generated; find it with:
#   docker compose logs api | grep "generated password"
# A set password must have 6+ characters, a digit, a lowercase and an uppercase letter, and a symbol.
ADMIN_EMAIL=admin@argus.local
ADMIN_PASSWORD=

# Locked out? Set to true, restart (docker compose up -d), sign in with the new password, then set it back to false.
RESET_ADMIN_PASSWORD=false

# Ports on your machine
ARGUS_PORT=8081
API_PORT=5183

# The iss claim on tokens. Downstream APIs validate it, so keep it stable.
JWT_ISSUER=http://localhost:5183

# A browser app allowed to call the API directly on API_PORT (CORS)
CORS_ORIGIN=http://localhost:5173

# Database password (the database isn't exposed outside Docker)
POSTGRES_PASSWORD=auth

# Optional SMTP for welcome emails
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
