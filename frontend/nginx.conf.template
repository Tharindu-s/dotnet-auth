# nginx's entrypoint fills in ${API_UPSTREAM} from the environment when the container starts
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Same origin as the app, so the SameSite=Strict refresh cookie works and CORS isn't needed.
    # The browser's Origin header passes through untouched; the API checks it for public clients.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /.well-known/ {
        proxy_pass ${API_UPSTREAM};
    }

    # Hashed build assets never change
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routes (/login, /sessions, ...) all load index.html
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
