# Copy to .env.local (gitignored) and fill in.

# ID of a *public* application client whose allowed origins include this app's origin
# (http://localhost:5173 in dev). Create one on /dev/apps or with POST /api/application-client.
VITE_APP_ID=

# Leave empty to call the API on the same origin (the Vite proxy in dev, nginx in Docker).
# Set it only if the API is on another origin, and add this app's origin to the API's Cors:AllowedOrigins.
VITE_API_BASE_URL=

# Dev server only: where the Vite proxy forwards /api and /.well-known
# API_PROXY_TARGET=http://localhost:5183
