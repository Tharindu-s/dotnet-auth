{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",
  "JWT": {
    "Issuer": "http://localhost:5183",
    "Audience": "http://localhost:5183"
  },

  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": "587"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },

  "Argus": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:8081" ],
    "AdminEmail": "admin@argus.local"
  },

  "RateLimiting": {
    "Credentials": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Refresh": { "PermitLimit": 30, "WindowSeconds": 60 }
  }
}
